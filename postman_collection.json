      "name": "02. Clientes - Crear nuevo cliente (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Valentina Mendoza\",\n  \"email\": \"valentina.mendoza@email.com\",\n  \"telefono\": \"+573151234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "clientes"]
        },
        "description": "Registra un nuevo cliente y guarda dinámicamente su identificador en la variable clienteId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201 Created o 409 si ya existe', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.collectionVariables.set('clienteId', jsonData.id);",
              "    console.log('Cliente ID guardado:', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
