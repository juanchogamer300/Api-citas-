      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Servicio en estado ok', function () {",
              "    var jsonData = pm.response.json();",
